@model nv3.Models.User
@{
    ViewBag.Title = "Thêm Quản trị viên mới";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card p-4 col-md-8 mx-auto">
    <h4 class="mb-3">Tạo tài khoản Admin</h4>
    <hr />

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="font-weight-bold">Họ và tên <span class="text-danger">*</span></label>
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Ví dụ: Nguyễn Văn A", required = "required" })
        </div>

        <div class="form-group">
            <label class="font-weight-bold">Email đăng nhập <span class="text-danger">*</span></label>
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "admin@example.com", required = "required" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="font-weight-bold">Mật khẩu <span class="text-danger">*</span></label>
            <input type="password" name="Password" class="form-control" placeholder="Nhập mật khẩu..." required />
        </div>

        <div class="form-group">
            <label class="font-weight-bold">Số điện thoại</label>
            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Tạo tài khoản</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary ml-2">Hủy bỏ</a>
        </div>
    }
</div>