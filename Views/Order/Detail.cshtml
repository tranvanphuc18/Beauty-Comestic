@model nv3.Models.Order

@{
    ViewBag.Title = "Hóa đơn #" + Model.OrderID;
}

<section class="container py-5">
    <h2 class="mb-4">Hóa đơn #@Model.OrderID</h2>

    <div class="row mb-4">
        <div class="col-md-6">
            <p><strong>Người nhận:</strong> @Model.ReceiverName</p>
            <p><strong>Điện thoại:</strong> @Model.ReceiverPhone</p>
            <p><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>
        </div>
        <div class="col-md-6">
            <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Thanh toán:</strong> @Model.PaymentStatus</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-end">Số lượng</th>
                    <th class="text-end">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.OrderDetails)
                {
                    <tr>
                        <td>@d.Product.ProductName</td>
                        <td class="text-end">@d.UnitPrice.ToString("N0") ₫</td>
                        <td class="text-end">@d.Quantity</td>
                        <td class="text-end">@((d.UnitPrice * d.Quantity).ToString("N0")) ₫</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Tổng tiền</th>
                    <th class="text-end">@Model.TotalAmount.ToString("N0") ₫</th>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex gap-2">
        @using (Html.BeginForm("Reorder", "Order", new { id = Model.OrderID }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">Mua lại</button>
        }
        <a href="@Url.Action("History", "Order")" class="btn btn-outline-secondary">← Lịch sử đơn hàng</a>
    </div>
</section>
