@model List<nv3.Models.Order>

@{
    ViewBag.Title = "Lịch sử giao dịch";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="m-0 font-weight-bold">Lịch sử giao dịch</h2>
        <a href="@Url.Action("Index", "Product")" class="btn btn-outline-danger btn-sm">
            Tiếp tục mua sắm
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card p-5 text-center shadow-sm">
            <p class="text-muted mb-3 fs-5">Bạn chưa có đơn hàng nào.</p>
            <div>
                <a href="@Url.Action("Index", "Product")" class="btn btn-danger px-4 py-2 font-weight-bold">Mua sắm ngay</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive bg-white rounded shadow-sm border p-3">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center">Trạng thái đơn</th>
                        <th class="text-center">Thanh toán</th>
                        <th style="width: 220px;" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td><strong>#@o.OrderId</strong></td>
                            <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end text-danger fw-bold">@o.TotalAmount.ToString("N0") ₫</td>
                            <td class="text-center">
                                @if (o.OrderStatus == "Pending")
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1">Chờ duyệt</span>
                                }
                                else if (o.OrderStatus == "Confirmed")
                                {
                                    <span class="badge bg-info text-white px-2 py-1">Đã duyệt</span>
                                }
                                else if (o.OrderStatus == "Shipping")
                                {
                                    <span class="badge bg-primary text-white px-2 py-1">Đang giao</span>
                                }
                                else if (o.OrderStatus == "Completed")
                                {
                                    <span class="badge bg-success text-white px-2 py-1">Hoàn thành</span>
                                }
                                else if (o.OrderStatus == "Cancelled")
                                {
                                    <span class="badge bg-danger text-white px-2 py-1">Đã hủy</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white px-2 py-1">@o.OrderStatus</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (o.PaymentStatus == "Paid")
                                {
                                    <span class="badge bg-success text-white px-2 py-1">Đã trả</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white px-2 py-1">Chưa trả</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="@Url.Action("Detail", "Order", new { id = o.OrderId })"
                                   class="btn btn-outline-primary btn-sm me-1">Chi tiết</a>

                                @if (o.OrderStatus == "Pending")
                                {
                                    using (Html.BeginForm("Cancel", "Order", new { id = o.OrderId }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm"
                                                onclick="return confirm('Bạn chắc chắn muốn hủy đơn hàng #@o.OrderId này?');">
                                            Hủy đơn
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
