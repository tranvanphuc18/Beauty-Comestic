@model nv3.ViewModels.CheckoutViewModel

@{
    ViewBag.Title = "Thanh toán";
}

<section class="container py-5">
    <h2 class="mb-4">Thanh toán</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            @using (Html.BeginForm("Checkout", "Order", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label" for="ReceiverName">Tên người nhận</label>
                    <input type="text" class="form-control" id="ReceiverName" name="ReceiverName"
                           value="@Model.ReceiverName" maxlength="100" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="ReceiverPhone">Số điện thoại</label>
                    <input type="tel" class="form-control" id="ReceiverPhone" name="ReceiverPhone"
                           value="@Model.ReceiverPhone" pattern="0[0-9]{9}" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="ShippingAddress">Địa chỉ giao hàng</label>
                    <input type="text" class="form-control" id="ShippingAddress" name="ShippingAddress"
                           value="@Model.ShippingAddress" maxlength="150" required />
                </div>
                <p class="text-muted">Hình thức thanh toán: thanh toán khi nhận hàng (COD).</p>

                <button type="submit" class="btn btn-danger">Xác nhận đặt hàng</button>
                <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-secondary">Quay lại giỏ hàng</a>
            }
        </div>

        <div class="col-lg-5">
            <div class="border rounded-3 p-3">
                <h5>Đơn hàng của bạn</h5>
                @foreach (var item in Model.Items)
                {
                    <div class="d-flex justify-content-between border-bottom py-2">
                        <span>@item.ProductName (@item.DetailName) × @item.Quantity</span>
                        <span>@item.Total.ToString("N0") ₫</span>
                    </div>
                }
                <div class="d-flex justify-content-between pt-3">
                    <strong>Tổng tiền</strong>
                    <strong>@Model.Total.ToString("N0") ₫</strong>
                </div>
            </div>
        </div>
    </div>
</section>
