@model nv3.Models.Product
@{
    ViewBag.Title = Model.Name;
    var details = Model.ProductDetails.OrderBy(d => d.ProductDetailId).ToList();
    var inStockDetails = details.Where(d => d.Quantity > 0).ToList();
    bool inStock = inStockDetails.Any();
    var first = inStock ? inStockDetails.First() : details.FirstOrDefault();
}

<div class="container py-4">
    <div class="row g-4">
        <div class="col-md-5">
            <img src="@Url.Content("~/Images/" + Model.Image)"
                 alt="@Model.Name"
                 class="img-fluid rounded border p-3 bg-white shadow-sm" />
        </div>

        <div class="col-md-7">
            <span class="badge bg-light text-danger border mb-2 px-3 py-1 font-weight-bold" style="letter-spacing: 1px;">
                @Model.Brand
            </span>
            <h2 class="mb-3 font-weight-bold">@Model.Name</h2>

            <p class="fs-4 fw-bold text-danger mb-3" id="detailPrice" style="font-size: 1.5rem;">
                @nv3.Helpers.ProductHelper.UnitPrice(first).ToString("N0") VNĐ
            </p>

            <p class="text-secondary"><strong>Mô tả:</strong> @Model.Description</p>

            <p class="text-muted">
                Đã bán @details.Sum(d => d.SoldQuantity) |
                @if (inStock)
                {
                    <span class="text-success font-weight-bold"><i class="fas fa-check-circle mr-1"></i>Còn hàng</span>
                }
                else
                {
                    <span class="text-danger font-weight-bold"><i class="fas fa-times-circle mr-1"></i>Hết hàng</span>
                }
            </p>

            @if (inStock)
            {
                using (Html.BeginForm("Add", "Cart", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Request.RawUrl" />

                    <div class="d-flex align-items-center gap-3 mb-3">
                        <label for="detailSelect" class="mb-0 mr-2"><strong>Phân loại:</strong></label>
                        <select id="detailSelect" name="id" class="form-select form-control" style="max-width:320px">
                            @foreach (var d in inStockDetails)
                            {
                                <option value="@d.ProductDetailId"
                                        data-price="@nv3.Helpers.ProductHelper.UnitPrice(d).ToString("N0")"
                                        data-stock="@d.Quantity">
                                    @d.DetailName - @nv3.Helpers.ProductHelper.UnitPrice(d).ToString("N0") VNĐ (còn @d.Quantity)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="d-flex align-items-center gap-3 mb-4">
                        <label for="quantity" class="mb-0 mr-2"><strong>Số lượng:</strong></label>
                        <input type="number" id="quantity" name="quantity"
                               class="form-control" style="width:100px"
                               value="1" min="1" required />
                    </div>

                    <div class="d-flex gap-2 mb-4">
                        <button type="submit" class="btn btn-outline-danger px-4 py-2 font-weight-bold mr-2">
                            <i class="fas fa-cart-plus mr-1"></i> Thêm vào giỏ hàng
                        </button>
                        <button type="submit" name="buyNow" value="true" class="btn btn-danger px-4 py-2 font-weight-bold">
                            Mua ngay
                        </button>
                    </div>
                }
            }
            else
            {
                <button type="button" class="btn btn-secondary mb-4" disabled>Hết hàng</button>
            }

            <!-- Nút quay lại được thiết kế bo tròn sang trọng có đường kẻ ngăn cách -->
            <div class="pt-3 border-top">
                <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary rounded-pill px-3 py-2 text-decoration-none shadow-sm font-weight-bold">
                    <i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách sản phẩm
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var sel = document.getElementById('detailSelect');
        var priceEl = document.getElementById('detailPrice');
        var qty = document.getElementById('quantity');
        if (!sel) return;
        function sync() {
            var opt = sel.options[sel.selectedIndex];
            priceEl.textContent = opt.getAttribute('data-price') + ' VNĐ';
            qty.max = opt.getAttribute('data-stock');
            if (parseInt(qty.value, 10) > parseInt(qty.max, 10)) { qty.value = qty.max; }
        }
        sel.addEventListener('change', sync);
        sync();
    })();
</script>