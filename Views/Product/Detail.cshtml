@model nv3.Models.Product

@{
    ViewBag.Title = Model.ProductName;
    bool inStock = Model.Quantity > 0;
}

<div class="container py-4">
    <div class="row g-4">
        <div class="col-md-5">
            <img src="@Url.Content("~/Images/" + Model.Image)"
                 alt="@Model.ProductName"
                 class="img-fluid rounded border p-3 bg-white" />
        </div>

        <div class="col-md-7">
            <span class="product-card-brand">@Model.Brand</span>
            <h2 class="mb-3">@Model.ProductName</h2>

            <p class="fs-4 fw-bold text-danger">@Model.Price.ToString("N0") VNĐ</p>
            <p><strong>Mô tả:</strong> @Model.Description</p>
            <p class="text-muted">
                Đã bán @Model.SoldQuantity |
                @if (inStock)
                {
                    <span class="text-success">Còn @Model.Quantity sản phẩm</span>
                }
                else
                {
                    <span class="text-danger">Hết hàng</span>
                }
            </p>

            @if (inStock)
            {
                using (Html.BeginForm("Add", "Cart", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ProductID" />
                    <input type="hidden" name="returnUrl" value="@Request.RawUrl" />

                    <div class="d-flex align-items-center gap-3 mb-3">
                        <label for="quantity" class="mb-0"><strong>Số lượng:</strong></label>
                        <input type="number" id="quantity" name="quantity"
                               class="form-control" style="width:100px"
                               value="1" min="1" max="@Model.Quantity" required />
                    </div>

                    <button type="submit" class="btn btn-outline-danger">Thêm vào giỏ hàng</button>
                    <button type="submit" name="buyNow" value="true" class="btn btn-danger">Mua ngay</button>
                }
            }
            else
            {
                <button type="button" class="btn btn-secondary" disabled>Hết hàng</button>
            }

            <div class="mt-4">
                @Html.ActionLink("← Quay lại danh sách", "Index", "Product", null, new { @class = "btn btn-link" })
            </div>
        </div>
    </div>
</div>
