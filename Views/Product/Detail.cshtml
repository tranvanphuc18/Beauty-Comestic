@model MyPham_Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
}

<div class="container">
    <h2>Chi tiết sản phẩm</h2>

    <div class="row">
        <div class="col-md-5">
            <img src="@Url.Content("~/Images/" + Model.Image)"
                 alt="@Model.Name"
                 class="img-responsive product-detail-image" />
            

            <div class="col-md-7">
                <h3>@Model.Name</h3>

                <p>
                    <strong>Thương hiệu:</strong> @Model.Brand
                </p>

                <p>
                    <strong>Giá:</strong> @Model.Price.ToString("N0") VNĐ
                </p>

                <p>
                    <strong>Mô tả:</strong> @Model.Description
                </p>
                <p style="color: #FFB800; font-size: 14px; margin: 8px 0;">
                    ★★★★★ <strong>@ViewBag.Rating</strong>
                    <span style="color: #666; margin-left: 8px;">(@ViewBag.ReviewCount | @ViewBag.SoldCount)</span>
                </p>
                @Html.ActionLink(
                    "Quay lại danh sách",
                    "Index",
                    "Product",
                    null,
                    new { @class = "btn btn-default" }
                )
            </div>

        </div>
</div>