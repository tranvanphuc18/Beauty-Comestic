@model nv3.Models.Product
@{
    ViewBag.Title = Model.Name;
    var details = Model.ProductDetails.OrderBy(d => d.ProductDetailId).ToList();
    var inStockDetails = details.Where(d => d.Quantity > 0).ToList();
    bool inStock = inStockDetails.Any();
    var first = inStock ? inStockDetails.First() : details.FirstOrDefault();
    var recommended = ViewBag.RecommendedProducts as List<nv3.Models.Product>;
    bool hasDiscount = (first != null && first.DiscountedPrice.HasValue && first.DiscountedPrice.Value < first.Price);
}

<div class="container py-4 py-md-5 my-2 my-md-3">

    <div class="row g-4 bg-white p-4 rounded-3 shadow-sm border">
        <!-- Cột ảnh sản phẩm -->
        <div class="col-md-5">
            <div class="position-relative text-center">
                <img src="@Url.Content("~/Images/" + Model.Image)"
                     onerror="this.onerror=null; this.src='@Url.Content("~/Content/Uploads/Products/" + Model.Image)';"
                     alt="@Model.Name"
                     class="img-fluid rounded border p-3 bg-white @(!inStock ? "product-img-out-of-stock" : "")"
                     style="max-height: 380px; width: 100%; object-fit: contain;" />
                @if (!inStock)
                {
                    <div class="sold-out-overlay rounded">
                        <span class="sold-out-badge">Hết hàng</span>
                    </div>
                }
                else if (hasDiscount)
                {
                    <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-3 py-2 shadow-sm font-weight-bold" style="font-size: 13px;">
                        ĐANG KHUYẾN MÃI
                    </span>
                }
            </div>

            <!-- KHỐI THÔNG SỐ SẢN PHẨM (LUXURY SPECS CARD) -->
            <div class="mt-3 p-3 rounded-3" style="background: #FFFDFC; border: 1px solid #F0DDE5; box-shadow: 0 4px 16px rgba(180, 50, 90, 0.04);">
                <!-- Header -->
                <div class="d-flex align-items-center justify-content-between pb-2 mb-2" style="border-bottom: 1px solid #F5E5EC;">
                    <span class="text-uppercase fw-bold text-dark small" style="letter-spacing: 0.6px; font-size: 12px;">
                        <i class="fas fa-sparkles text-danger" style="margin-right: 6px;"></i>Thông số sản phẩm
                    </span>
                    <span class="badge rounded-pill" style="background: #FCE7EF; color: #E91E63; font-size: 11px; padding: 4px 9px;">
                        <i class="fas fa-check-circle" style="margin-right: 4px;"></i>Chính hãng
                    </span>
                </div>

                <!-- Danh sách thông số dạng hàng gọn gàng -->
                <div style="font-size: 13px;">
                    <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px dashed #F3E3EA;">
                        <span class="text-muted d-inline-flex align-items-center">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 24px; height: 24px; background: #FFF0F5; color: #E91E63; font-size: 11px; margin-right: 8px;">
                                <i class="fas fa-crown"></i>
                            </span>
                            Thương hiệu
                        </span>
                        <strong class="text-dark">@Model.Brand</strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px dashed #F3E3EA;">
                        <span class="text-muted d-inline-flex align-items-center">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 24px; height: 24px; background: #FFF0F5; color: #E91E63; font-size: 11px; margin-right: 8px;">
                                <i class="fas fa-layer-group"></i>
                            </span>
                            Danh mục
                        </span>
                        <span class="text-dark fw-bold">@(Model.Category != null ? Model.Category.CategoryName : "Mỹ phẩm")</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px dashed #F3E3EA;">
                        <span class="text-muted d-inline-flex align-items-center">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 24px; height: 24px; background: #FFF0F5; color: #E91E63; font-size: 11px; margin-right: 8px;">
                                <i class="fas fa-magic"></i>
                            </span>
                            Loại da phù hợp
                        </span>
                        <span class="text-danger fw-bold text-end" style="max-width: 55%;">
                            @(Model.SkinTypes != null && Model.SkinTypes.Any() ? string.Join(", ", Model.SkinTypes.Select(s => s.SkinTypeName)) : "Mọi loại da")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px dashed #F3E3EA;">
                        <span class="text-muted d-inline-flex align-items-center">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 24px; height: 24px; background: #FFF0F5; color: #E91E63; font-size: 11px; margin-right: 8px;">
                                <i class="fas fa-box-open"></i>
                            </span>
                            Quy cách
                        </span>
                        <span class="text-dark fw-bold text-end" style="max-width: 55%;">
                            @(details.Any() ? string.Join(" | ", details.Select(d => d.DetailName)) : "Tiêu chuẩn")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px dashed #F3E3EA;">
                        <span class="text-muted d-inline-flex align-items-center">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 24px; height: 24px; background: #FFF0F5; color: #E91E63; font-size: 11px; margin-right: 8px;">
                                <i class="fas fa-globe-americas"></i>
                            </span>
                            Xuất xứ
                        </span>
                        <span class="text-dark fw-bold">Nhập khẩu chính hãng</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted d-inline-flex align-items-center">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 24px; height: 24px; background: #FFF0F5; color: #E91E63; font-size: 11px; margin-right: 8px;">
                                <i class="fas fa-calendar-check"></i>
                            </span>
                            Hạn sử dụng
                        </span>
                        <span class="text-dark fw-bold">36 tháng (12M mở nắp)</span>
                    </div>
                </div>

                <!-- Footer tem cam kết an tâm -->
                <div class="d-flex justify-content-between align-items-center pt-2 mt-2" style="border-top: 1px solid #F5E5EC; font-size: 11.5px;">
                    <span style="color: #198754; font-weight: 600;"><i class="fas fa-shield-alt" style="margin-right: 4px;"></i>An toàn cho da</span>
                    <span style="color: #198754; font-weight: 600;"><i class="fas fa-leaf" style="margin-right: 4px;"></i>Lành tính</span>
                    <span style="color: #E91E63; font-weight: 600;"><i class="fas fa-sync-alt" style="margin-right: 4px;"></i>Đổi trả 7 ngày</span>
                </div>
            </div>
        </div>

        <!-- Cột thông tin chi tiết -->
        <div class="col-md-7">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-light text-danger border px-3 py-1 font-weight-bold" style="letter-spacing: 0.5px;">
                    @Model.Brand
                </span>
                @if (Model.Category != null)
                {
                    <span class="badge bg-light text-secondary border px-2 py-1">
                        @Model.Category.CategoryName
                    </span>
                }
            </div>

            <h2 class="mb-2 fw-bold text-dark">@Model.Name</h2>

            <!-- Đánh giá & Lượt mua -->
            <div class="d-flex align-items-center gap-3 mb-3 text-muted small">
                <span>
                    <strong class="text-warning">★ @Model.Rating.ToString("0.0")</strong>
                </span>
                <span>|</span>
                <span>Đã bán <strong>@details.Sum(d => d.SoldQuantity)</strong></span>
                <span>|</span>
                <span>Lượt xem: <strong>@Model.ViewQuantity</strong></span>
                <span>|</span>
                @if (inStock)
                {
                    <span class="text-success font-weight-bold"><i class="fas fa-check-circle mr-1"></i>Còn hàng</span>
                }
                else
                {
                    <span class="text-danger font-weight-bold"><i class="fas fa-times-circle mr-1"></i>Hết hàng</span>
                }
            </div>

            <!-- Giá hiển thị & Khuyến mãi -->
            <div class="p-3 mb-3 rounded" style="background-color: #fff5f7;">
                @if (hasDiscount)
                {
                    <del class="text-muted small me-2" id="detailOriginalPrice" style="font-size: 1.1rem;">
                        @(first != null ? first.Price.ToString("N0") : "0") đ
                    </del>
                }
                <span class="fs-3 fw-bold text-danger" id="detailPrice">
                    @(first != null ? nv3.Helpers.ProductHelper.UnitPrice(first).ToString("N0") : "0") VNĐ
                </span>
                <span class="text-secondary small ms-2" id="detailStockStatus">
                    @(inStock ? "(Có sẵn)" : "(Hết hàng)")
                </span>
            </div>

            <!-- LOẠI DA PHÙ HỢP -->
            <div class="mb-3 p-3 rounded border bg-light">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <strong class="text-dark small text-uppercase" style="letter-spacing: 0.5px;">
                        <i class="fas fa-magic text-danger mr-1"></i> Loại da phù hợp:
                    </strong>
                    <small class="text-muted fst-italic">Bấm vào để xem các sản phẩm cùng loại da</small>
                </div>
                <div>
                    @if (Model.SkinTypes != null && Model.SkinTypes.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var skin in Model.SkinTypes)
                            {
                                <a href="@Url.Action("Index", "Product", new { skinTypes = skin.SkinTypeId, id = (string)null })"
                                   class="badge bg-white text-dark border px-3 py-2 text-decoration-none shadow-sm skin-type-pill"
                                   title="Xem tất cả sản phẩm dành cho @skin.SkinTypeName">
                                    <span class="text-danger mr-1">✦</span> <strong>@skin.SkinTypeName</strong>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="badge bg-white text-secondary border px-3 py-2">
                            <span class="text-success mr-1">✓</span> Phù hợp cho mọi loại da
                        </span>
                    }
                </div>
            </div>

            <!-- Mô tả ngắn -->
            <p class="text-secondary mb-3"><strong>Mô tả:</strong> @Model.Description</p>

            <!-- KHỐI ĐẶT HÀNG / TỒN KHO -->
            @if (inStock)
            {
                using (Html.BeginForm("Add", "Cart", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Request.RawUrl" />

                    <!-- Chọn phân loại -->
                    <div class="mb-3">
                        <label for="detailSelect" class="form-label font-weight-bold">Phân loại / Dung tích:</label>
                        <select name="productDetailId" id="detailSelect" class="form-select form-control" style="max-width: 320px;">
                            @foreach (var d in details)
                            {
                                decimal uPrice = nv3.Helpers.ProductHelper.UnitPrice(d);
                                string outText = (d.Quantity <= 0) ? " [Hết hàng]" : "";
                                <option value="@d.ProductDetailId"
                                        data-price="@uPrice.ToString("N0")"
                                        data-stock="@d.Quantity"
                                        @(d.Quantity <= 0 ? "disabled" : "")
                                        @(d == first ? "selected" : "")>
                                    @d.DetailName - @uPrice.ToString("N0") đ @outText
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Hiển thị số lượng mua & Tồn kho thực tế -->
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <label for="quantity" class="mb-0 text-nowrap" style="min-width: 90px;"><strong>Số lượng:</strong></label>
                        <input type="number" id="quantity" name="quantity"
                               class="form-control" style="width: 100px;"
                               value="1" min="1" max="@(first != null ? first.Quantity : 1)" required />
                        <span class="text-muted small">
                            (Còn lại <strong id="detailStock" class="text-danger">@(first != null ? first.Quantity : 0)</strong> sản phẩm trong kho)
                        </span>
                    </div>

                    <!-- Nút mua hàng -->
                    <div class="d-flex gap-2 mb-3">
                        <button type="submit" class="btn btn-outline-danger px-4 py-2 font-weight-bold mr-2">
                            <i class="fas fa-cart-plus mr-1"></i> Thêm vào giỏ hàng
                        </button>
                        <button type="submit" name="buyNow" value="true" class="btn btn-danger px-4 py-2 font-weight-bold">
                            Mua ngay
                        </button>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-secondary p-3 mb-4 rounded border">
                    <p class="mb-1 text-danger font-weight-bold">
                        <i class="fas fa-exclamation-circle mr-1"></i> Sản phẩm hiện đã tạm hết hàng trong kho!
                    </p>
                    <small class="text-muted">Cửa hàng đang nhập thêm đợt hàng mới. Quý khách vui lòng tham khảo các sản phẩm gợi ý bên dưới.</small>
                </div>

                <div class="d-flex gap-2 mb-4">
                    <button type="button" class="btn btn-secondary px-4 py-2 font-weight-bold mr-2" disabled style="opacity: 0.6; cursor: not-allowed;">
                        Thêm vào giỏ hàng
                    </button>
                    <button type="button" class="btn btn-secondary px-4 py-2 font-weight-bold" disabled style="opacity: 0.6; cursor: not-allowed;">
                        Mua ngay
                    </button>
                </div>
            }

            <div class="pt-3 border-top">
                <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary rounded-pill px-3 py-2 text-decoration-none shadow-sm font-weight-bold">
                    <i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách sản phẩm
                </a>
            </div>
        </div>
    </div>

    <!-- KHỐI GỢI Ý SẢN PHẨM -->
    @if (recommended != null && recommended.Any())
    {
        <div class="mt-5 pt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h4 class="fw-bold text-dark m-0">
                        <i class="fas fa-fire text-danger mr-1"></i> Gợi ý sản phẩm ưa chuộng
                    </h4>
                    <small class="text-muted">Dựa trên các sản phẩm cùng danh mục có lượt mua và đánh giá cao nhất</small>
                </div>
                @if (Model.Category != null)
                {
                    <a href="@Url.Action("Index", "Product", new { category = nv3.Helpers.ProductHelper.ToSlug(Model.Category.CategoryName) })" class="text-danger text-decoration-none fw-bold small">
                        Xem tất cả cùng danh mục →
                    </a>
                }
            </div>

            <div class="row g-3">
                @foreach (var p in recommended)
                {
                    var pDetail = nv3.Helpers.ProductHelper.FirstInStock(p);
                    bool pOutOfStock = (pDetail == null);
                    decimal pPrice = nv3.Helpers.ProductHelper.DisplayPrice(p);
                    int pSold = p.ProductDetails != null ? p.ProductDetails.Sum(d => d.SoldQuantity) : 0;

                    <div class="col-6 col-md-3">
                        <div class="card h-100 border rounded-3 shadow-sm product-card @(pOutOfStock ? "is-out-of-stock" : "")">
                            <a class="product-media position-relative d-block text-center p-2" href="@Url.Action("Detail", "Product", new { id = p.ProductId })">
                                <img src="@Url.Content("~/Images/" + p.Image)"
                                     onerror="this.onerror=null; this.src='@Url.Content("~/Content/Uploads/Products/" + p.Image)';"
                                     class="product-image" alt="@p.Name" style="height: 160px; width: 100%; object-fit: contain;" />
                                @if (pOutOfStock)
                                {
                                    <div class="sold-out-overlay">
                                        <span class="sold-out-badge" style="width: 65px; height: 65px; font-size: 11px;">Hết hàng</span>
                                    </div>
                                }
                            </a>
                            <div class="card-body p-3 d-flex flex-column">
                                <small class="text-muted">@p.Brand</small>
                                <h6 class="card-title text-truncate mb-1" title="@p.Name">
                                    <a href="@Url.Action("Detail", "Product", new { id = p.ProductId })" class="text-dark text-decoration-none">@p.Name</a>
                                </h6>
                                <p class="text-danger fw-bold mb-1">@pPrice.ToString("N0") đ</p>
                                <div class="d-flex justify-content-between text-muted small mb-2">
                                    <span>Đã bán: <strong>@pSold</strong></span>
                                    <span class="text-warning">★ @p.Rating.ToString("0.0")</span>
                                </div>
                                <a href="@Url.Action("Detail", "Product", new { id = p.ProductId })" class="btn btn-sm btn-outline-danger mt-auto">
                                    Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<script>
    (function () {
        var sel = document.getElementById('detailSelect');
        var priceEl = document.getElementById('detailPrice');
        var qty = document.getElementById('quantity');
        var stockEl = document.getElementById('detailStock');
        if (!sel) return;

        function sync() {
            var opt = sel.options[sel.selectedIndex];
            if (!opt) return;
            priceEl.textContent = opt.getAttribute('data-price') + ' VNĐ';
            var stock = parseInt(opt.getAttribute('data-stock'), 10) || 0;
            if (stockEl) {
                stockEl.textContent = stock;
            }
            if (qty) {
                qty.max = stock;
                if (parseInt(qty.value, 10) > stock) {
                    qty.value = stock > 0 ? stock : 1;
                }
            }
        }
        sel.addEventListener('change', sync);
        sync();
    })();
</script>
