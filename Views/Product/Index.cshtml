@model IEnumerable<nv3.Models.Product>

@{
    ViewBag.Title = "Danh sách sản phẩm";

    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
    string keyword = ViewBag.Keyword as string;
    string category = ViewBag.SelectedCategory as string;
    string[] selSkin = (ViewBag.SelectedSkinTypes as string[]) ?? new string[0];
    string[] selBrands = (ViewBag.SelectedBrands as string[]) ?? new string[0];

    // Tạo link chuyển trang nhưng vẫn giữ nguyên từ khóa + bộ lọc đang chọn
    Func<int, string> pageUrl = p =>
    {
        var qs = new List<string>();
        if (!string.IsNullOrEmpty(keyword)) { qs.Add("keyword=" + HttpUtility.UrlEncode(keyword)); }
        if (!string.IsNullOrEmpty(category)) { qs.Add("category=" + HttpUtility.UrlEncode(category)); }
        foreach (var s in selSkin) { qs.Add("skinTypes=" + HttpUtility.UrlEncode(s)); }
        foreach (var b in selBrands) { qs.Add("brands=" + HttpUtility.UrlEncode(b)); }
        qs.Add("page=" + p);
        return Url.Action("Index", "Product") + "?" + string.Join("&", qs);
    };
}

<div class="container product-page">
    <h2 class="mb-4">Danh sách sản phẩm</h2>

    <div class="row">
        <div class="col-lg-3 mb-4">
            @Html.Partial("_ProductFilter")
        </div>

        <div class="col-lg-9">
            @if (Model == null || !Model.Any())
            {
                <p>Không có sản phẩm nào phù hợp với từ khóa hoặc bộ lọc.</p>
            }
            else
            {
                <p class="text-muted">Tìm thấy @ViewBag.TotalItems sản phẩm</p>

                <div class="row g-4">
                    @foreach (var product in Model)
                    {
                        var detail = product.ProductDetails == null
                            ? null
                            : product.ProductDetails
                                .OrderBy(d => d.ProductDetailId)
                                .FirstOrDefault();

                        var price = detail == null
                            ? 0m
                            : (detail.DiscountedPrice.HasValue
                                ? detail.DiscountedPrice.Value
                                : detail.Price);

                        <div class="col-md-6 col-xl-4">
                            <div class="card product-card">
                                <a class="product-media"
                                   href="@Url.Action("Detail", "Product", new { id = product.ProductID })"
                                   tabindex="-1"
                                   aria-hidden="true">
                                    <img src="@Url.Content("~/Images/" + product.Image)"
                                         class="product-image"
                                         alt="@product.ProductName"
                                         loading="lazy" />
                                </a>

                                <div class="card-body">
                                    <span class="product-card-brand">
                                        @product.Brand
                                    </span>

                                    <h4 class="product-name">
                                        <a href="@Url.Action("Detail", "Product", new { id = product.ProductID })">@product.ProductName</a>
                                    </h4>

                                    <p class="product-price">
                                        @price.ToString("N0")
                                        <small>VNĐ</small>
                                    </p>

                                    <div class="product-buttons">
                                        @Html.ActionLink("Xem chi tiết", "Detail", "Product",
                                            new { id = product.ProductID }, new { @class = "btn btn-primary" })

                                        @using (Html.BeginForm("Add", "Cart", FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@product.ProductID" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <input type="hidden" name="returnUrl" value="@Request.RawUrl" />
                                            <button type="submit" class="btn btn-danger">Thêm vào giỏ hàng</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                if (totalPages > 1)
                {
                    <nav class="mt-4" aria-label="Phân trang sản phẩm">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(page <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@pageUrl(page - 1)">&laquo;</a>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == page ? "active" : "")">
                                    <a class="page-link" href="@pageUrl(i)">@i</a>
                                </li>
                            }
                            <li class="page-item @(page >= totalPages ? "disabled" : "")">
                                <a class="page-link" href="@pageUrl(page + 1)">&raquo;</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
