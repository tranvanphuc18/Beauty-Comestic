@model List<nv3.ViewModels.CartItem>

@{
    ViewBag.Title = "Giỏ hàng";
}

<section class="container py-5">
    <h2 class="mb-4">Giỏ hàng của bạn</h2>

    @if (!Model.Any())
    {
        <p class="text-muted">Giỏ hàng của bạn đang trống.</p>
        <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary">Tiếp tục mua sắm</a>
    }
    else
    {
        foreach (var item in Model)
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 border-bottom py-3">
                <div class="d-flex align-items-center gap-3">
                    <img src="@Url.Content("~/Images/" + item.Image)" alt="@item.ProductName"
                         style="width:70px;height:70px;object-fit:contain;border:1px solid #EADCE2;border-radius:8px;padding:4px;background:#fff;" />
                    <div>
                        <strong class="d-block mb-1">@item.ProductName</strong>
                        <small class="d-block text-muted">Phân loại: @item.DetailName</small>
                        <span class="text-muted">@item.Price.ToString("N0") ₫</span>
                        <small class="d-block text-muted">Còn @item.Stock sản phẩm</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @using (Html.BeginForm("Update", "Cart", FormMethod.Post, new { @class = "d-flex gap-2" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.ProductDetailId" />
                        <input type="number" name="quantity" value="@item.Quantity"
                               min="1" max="@item.Stock" class="form-control form-control-sm" style="width:80px" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Cập nhật</button>
                    }

                    <strong style="min-width:110px;text-align:right">@item.Total.ToString("N0") ₫</strong>

                    @using (Html.BeginForm("Remove", "Cart", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.ProductDetailId" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">Xóa</button>
                    }
                </div>
            </div>
        }

        <div class="border rounded-3 p-4 mt-4">
            <div class="d-flex justify-content-between mb-3">
                <strong>Tổng tiền:</strong>
                <strong>@Model.Sum(i => i.Total).ToString("N0") ₫</strong>
            </div>

            <div class="d-flex flex-wrap gap-2">
                @using (Html.BeginForm("Clear", "Cart", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">Xóa giỏ hàng</button>
                }

                <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary">Tiếp tục mua sắm</a>

                <a href="@Url.Action("Checkout", "Order")" class="btn btn-danger">Thanh toán</a>
            </div>
        </div>
    }
</section>
