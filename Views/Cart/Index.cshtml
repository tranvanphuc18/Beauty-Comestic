@model List<nv3.ViewModels.CartItem>

@{
    ViewBag.Title = "Giỏ hàng";
}

<section class="container py-5">
    <h2 class="mb-4">Giỏ hàng của bạn</h2>

    @if (!Model.Any())
    {
        <p class="text-muted">Giỏ hàng của bạn đang trống.</p>
        <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary">Tiếp tục mua sắm</a>
    }
    else
    {
        foreach (var item in Model)
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 border-bottom py-3">
                <div class="d-flex align-items-center gap-3">
                    <img src="@Url.Content("~/Images/" + item.Image)" alt="@item.ProductName"
                         style="width:70px;height:70px;object-fit:contain;border:1px solid #EADCE2;border-radius:8px;padding:4px;background:#fff;" />
                    <div>
                        <strong class="d-block mb-1">@item.ProductName</strong>
                        <small class="d-block text-muted">Phân loại: @item.DetailName</small>
                        <span class="text-muted">@item.Price.ToString("N0") ₫</span>
                        <small class="d-block text-muted">Còn @item.Stock sản phẩm</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @using (Html.BeginForm("Update", "Cart", FormMethod.Post, new { @class = "d-flex gap-2" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.ProductDetailId" />
                        <input type="number" name="quantity" value="@item.Quantity"
                               min="1" max="@item.Stock"
                               class="form-control form-control-sm qty-input" style="width:80px"
                               data-price="@item.Price"
                               data-id="@item.ProductDetailId" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Cập nhật</button>
                    }

                    <strong class="item-total" data-id="@item.ProductDetailId" style="min-width:110px;text-align:right">@item.Total.ToString("N0") ₫</strong>

                    @using (Html.BeginForm("Remove", "Cart", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.ProductDetailId" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">Xóa</button>
                    }
                </div>
            </div>
        }

        <div class="border rounded-3 p-4 mt-4">
            <div class="d-flex justify-content-between mb-3">
                <strong>Tổng tiền:</strong>
                <strong id="cart-total">@Model.Sum(i => i.Total).ToString("N0") ₫</strong>
            </div>

            <div class="d-flex flex-wrap gap-2">
                @using (Html.BeginForm("Clear", "Cart", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">Xóa giỏ hàng</button>
                }

                <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary">Tiếp tục mua sắm</a>

                <a href="@Url.Action("Checkout", "Order")" class="btn btn-danger">Thanh toán</a>
            </div>
        </div>
    }
</section>

@section Scripts {
<script>
    document.querySelectorAll('.qty-input').forEach(function (input) {
        input.addEventListener('input', function () {
            var qty = parseInt(this.value) || 1;
            var price = parseFloat(this.getAttribute('data-price'));
            var id = this.getAttribute('data-id');
            var total = qty * price;

            // Cập nhật giá từng sản phẩm theo data-id
            var totalEl = document.querySelector('.item-total[data-id="' + id + '"]');
            if (totalEl) {
                totalEl.textContent = total.toLocaleString('vi-VN') + ' ₫';
            }

            // Cập nhật tổng tiền giỏ hàng
            recalcCartTotal();
        });
    });

    function recalcCartTotal() {
        var grandTotal = 0;
        document.querySelectorAll('.qty-input').forEach(function (input) {
            var qty = parseInt(input.value) || 1;
            var price = parseFloat(input.getAttribute('data-price'));
            grandTotal += qty * price;
        });
        var cartTotalEl = document.getElementById('cart-total');
        if (cartTotalEl) {
            cartTotalEl.textContent = grandTotal.toLocaleString('vi-VN') + ' ₫';
        }
    }
</script>
}
