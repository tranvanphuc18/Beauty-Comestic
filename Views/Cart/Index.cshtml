@{
    ViewBag.Title = "Giỏ hàng";
}
<section class="container py-5">
    <h2 class="mb-4">Giỏ hàng của bạn</h2>

    <div id="cartItems"></div>

    <div class="border rounded-3 p-4 mt-4">
        <div class="d-flex justify-content-between mb-3">
            <strong>Tổng tiền:</strong>
            <strong id="cartTotal">0 ₫</strong>
        </div>

        <button type="button" id="clearCart"
                class="btn btn-outline-danger">
            Xóa giỏ hàng
        </button>

        <a href="@Url.Action("Index", "Product")"
           class="btn btn-outline-secondary">
            Tiếp tục mua sắm
        </a>

        <button type="button" id="checkout"
                class="btn btn-danger">
            Thanh toán
        </button>
    </div>
</section>

@section scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const cartKey = "beautyCart";
            const itemsContainer = document.getElementById("cartItems");
            const totalElement = document.getElementById("cartTotal");

            function getCart() {
                try {
                    return JSON.parse(localStorage.getItem(cartKey)) || [];
                } catch {
                    return [];
                }
            }

            function saveCart(cart) {
                localStorage.setItem(cartKey, JSON.stringify(cart));
            }

            function formatMoney(value) {
                return Number(value).toLocaleString("vi-VN") + " ₫";
            }

            // HÀM TỰ ĐỘNG LẤY ĐÚNG ẢNH CỦA TỪNG SẢN PHẨM
            function getProductImage(item) {
                if (item.image && typeof item.image === "string" && item.image.trim() !== "") {
                    return item.image.startsWith("/") ? item.image : "/Images/" + item.image;
                }
                const name = (item.name || "").toLowerCase();
                if (name.includes("cerave") || name.includes("sữa rửa mặt")) return "/Images/ceraVe.jpg";
                if (name.includes("klairs") || name.includes("toner")) return "/Images/klairs.jpg";
                if (name.includes("melano") || name.includes("serum")) return "/Images/melano.jpg";
                if (name.includes("roche") || name.includes("dưỡng") || name.includes("phục hồi")) return "/Images/larocheposay.jpg";
                if (name.includes("anessa") || name.includes("chống nắng")) return "/Images/anessa.jpg";
                if (name.includes("ysl") || name.includes("son")) return "/Images/ysl.jpg";
                return "/Images/ceraVe.jpg";
            }

            function renderCart() {
                const cart = getCart();
                itemsContainer.innerHTML = "";

                if (cart.length === 0) {
                    itemsContainer.innerHTML =
                        '<p class="text-muted">Giỏ hàng của bạn đang trống.</p>';
                    totalElement.textContent = "0 ₫";
                    updateHeaderCount();
                    return;
                }

                let total = 0;

                cart.forEach(function (item, index) {
                    const price = Number(item.price) || 0;
                    const quantity = Math.max(1, Number(item.quantity) || 1);
                    total += price * quantity;

                    const row = document.createElement("div");
                    row.className =
                        "d-flex justify-content-between align-items-center gap-3 border-bottom py-3";

                    // ================= 1. KHỐI BÊN TRÁI: ẢNH + TÊN + GIÁ =================
                    const leftSide = document.createElement("div");
                    leftSide.className = "d-flex align-items-center gap-3";

                    // Tạo ảnh sản phẩm
                    const img = document.createElement("img");
                    img.src = getProductImage(item);
                    img.alt = item.name || "Sản phẩm";
                    img.style.width = "70px";
                    img.style.height = "70px";
                    img.style.objectFit = "contain";
                    img.style.border = "1px solid #EADCE2";
                    img.style.borderRadius = "8px";
                    img.style.padding = "4px";
                    img.style.backgroundColor = "#ffffff";
                    img.style.flexShrink = "0";

                    // Thông tin chữ
                    const info = document.createElement("div");

                    const name = document.createElement("strong");
                    name.textContent = item.name || "Sản phẩm";
                    name.style.display = "block";
                    name.style.marginBottom = "4px";

                    const priceText = document.createElement("p");
                    priceText.className = "mb-0 text-muted";
                    priceText.textContent = formatMoney(price);

                    info.appendChild(name);
                    info.appendChild(priceText);

                    // Gắn ảnh và thông tin vào khối trái
                    leftSide.appendChild(img);
                    leftSide.appendChild(info);

                    // ================= 2. KHỐI BÊN PHẢI: NÚT BẤM =================
                    const controls = document.createElement("div");
                    controls.className = "d-flex align-items-center gap-2";

                    const minus = document.createElement("button");
                    minus.className = "btn btn-outline-secondary btn-sm";
                    minus.textContent = "−";
                    minus.type = "button";
                    minus.addEventListener("click", function () {
                        const current = getCart();
                        current[index].quantity =
                            Math.max(1, (Number(current[index].quantity) || 1) - 1);
                        saveCart(current);
                        renderCart();
                    });

                    const qty = document.createElement("span");
                    qty.className = "px-2";
                    qty.textContent = quantity;

                    const plus = document.createElement("button");
                    plus.className = "btn btn-outline-secondary btn-sm";
                    plus.textContent = "+";
                    plus.type = "button";
                    plus.addEventListener("click", function () {
                        const current = getCart();
                        current[index].quantity =
                            (Number(current[index].quantity) || 1) + 1;
                        saveCart(current);
                        renderCart();
                    });

                    const remove = document.createElement("button");
                    remove.className = "btn btn-outline-danger btn-sm";
                    remove.textContent = "Xóa";
                    remove.type = "button";
                    remove.addEventListener("click", function () {
                        const current = getCart();
                        current.splice(index, 1);
                        saveCart(current);
                        renderCart();
                    });

                    controls.append(minus, qty, plus, remove);

                    // Gắn khối trái (có ảnh) và khối phải vào hàng
                    row.append(leftSide, controls);
                    itemsContainer.appendChild(row);
                });

                totalElement.textContent = formatMoney(total);
                updateHeaderCount();
            }

            function updateHeaderCount() {
                const badge = document.getElementById("headerCartCount");
                if (!badge) return;

                const count = getCart().reduce(function (sum, item) {
                    return sum + Math.max(0, Number(item.quantity) || 1);
                }, 0);

                badge.textContent = count;
            }

            document.getElementById("clearCart").addEventListener("click", function () {
                saveCart([]);
                renderCart();
            });

            document.getElementById("checkout").addEventListener("click", function () {
                if (getCart().length === 0) {
                    alert("Giỏ hàng đang trống!");
                    return;
                }

                alert("Đây là giao diện demo. Chức năng thanh toán chưa được kết nối.");
            });

            renderCart();
        });
    </script>
}
