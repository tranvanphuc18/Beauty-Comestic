@{
    bool isLoggedIn = Session["CustomerID"] != null;
    string accountUrl = isLoggedIn ? Url.Action("Profile", "Account") : Url.Action("Login", "Account");
    string accountLabel = isLoggedIn ? (Session["CustomerName"] as string ?? "Tài khoản") : "Tài khoản";
    string accountEmail = Session["UserEmail"] as string;
    bool isAdmin = isLoggedIn && (Session["Role"] as string) == "Admin";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - BeautyCosmetic</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <link rel="stylesheet"
          href="@Url.Content("~/Content/site.css")" />

    <link rel="stylesheet"
          href="@Url.Content("~/Content/home.css")" />

    <style>
        /* ===== Menu tài khoản trên header (rê chuột để mở) ===== */
        .header-account {
            position: relative;
            display: flex;
        }

        .account-label {
            display: inline-flex;
            align-items: center;
            gap: 3px;
        }

        .account-label-text {
            max-width: 96px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .account-caret {
            width: 9px;
            height: 9px;
            flex: none;
            fill: none;
            stroke: currentColor;
            stroke-width: 2.6;
            stroke-linecap: round;
            stroke-linejoin: round;
            transition: transform 0.2s ease;
        }

        /* Hộp menu: padding-top tạo "cầu nối" để chuột đi từ nút xuống menu không bị mất hover */
        .account-dropdown {
            position: absolute;
            top: 100%;
            right: -14px;
            z-index: 1200;
            min-width: 240px;
            max-width: calc(100vw - 24px);
            padding-top: 12px;
            visibility: hidden;
            opacity: 0;
            transform: translateY(6px);
            transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
        }

        .account-dropdown-panel {
            position: relative;
            padding: 8px;
            background: #fff;
            border: 1px solid var(--border, #F0E1E7);
            border-radius: 14px;
            box-shadow: 0 16px 36px rgba(90, 30, 55, 0.14);
        }

            /* mũi tên nhỏ chỉ lên nút tài khoản */
            .account-dropdown-panel::before {
                content: "";
                position: absolute;
                top: -6px;
                right: 38px;
                width: 10px;
                height: 10px;
                background: #fff;
                border-top: 1px solid var(--border, #F0E1E7);
                border-left: 1px solid var(--border, #F0E1E7);
                transform: rotate(45deg);
            }

        .account-dropdown-head {
            display: flex;
            flex-direction: column;
            gap: 1px;
            padding: 8px 12px 6px;
        }

        .account-dropdown-name {
            overflow: hidden;
            color: var(--text, #29252A);
            font-size: 14px;
            font-weight: 700;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .account-dropdown-email {
            overflow: hidden;
            color: var(--muted, #77717A);
            font-size: 12px;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .account-divider {
            height: 1px;
            margin: 6px 4px;
            background: var(--border, #F0E1E7);
        }

        .account-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            color: var(--text, #29252A);
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            border-radius: 10px;
            transition: background-color 0.15s ease, color 0.15s ease;
        }

            .account-item:hover,
            .account-item:focus-visible {
                color: var(--primary-dark, #C2185B);
                background: var(--primary-light, #FCE7EF);
                outline: none;
            }

        .account-item-icon {
            width: 19px;
            height: 19px;
            flex: none;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .account-item--danger {
            color: #C62828;
        }

            .account-item--danger:hover,
            .account-item--danger:focus-visible {
                color: #B71C1C;
                background: #FDECEA;
            }

        /* ----- Hiển thị menu ----- */

        /* Máy tính (có chuột): rê vào là mở */
        @@media (hover: hover) {
            .header-account:hover .account-dropdown {
                visibility: visible;
                opacity: 1;
                transform: none;
            }

            .header-account:hover .account-trigger {
                color: var(--primary, #E91E63);
            }

            .header-account:hover .account-caret {
                transform: rotate(180deg);
            }
        }

        /* Bàn phím (Tab) và màn hình cảm ứng (JS thêm class is-open) */
        .header-account.is-open .account-dropdown,
        .account-trigger:focus-visible + .account-dropdown,
        .account-dropdown:focus-within {
            visibility: visible;
            opacity: 1;
            transform: none;
        }

        .header-account.is-open .account-caret {
            transform: rotate(180deg);
        }

        /* Điện thoại: nhãn bị ẩn nên menu căn sát mép phải nút */
        @@media (max-width: 767.98px) {
            .account-label {
                display: none;
            }

            .account-dropdown {
                right: -8px;
                min-width: 230px;
            }

            .account-dropdown-panel::before {
                right: 18px;
            }
        }
    </style>

    @RenderSection("styles", required: false)
</head>
<body>
    <div class="top-notice">
        <div class="container text-center">
            <span>BeautyCosmetic</span>
            <span class="notice-divider">|</span>
            Chăm sóc vẻ đẹp của bạn mỗi ngày
        </div>
    </div>

    <header class="site-header">
        <div class="container">
            <div class="header-main">
                <a class="brand"
                   href="@Url.Action("Index", "Home")"
                   aria-label="BeautyCosmetic - Trang chủ">
                    <span class="brand-highlight">Beauty</span><span>Cosmetic</span>
                    <span class="brand-dot">.</span>
                </a>

                <form class="search-box" action="@Url.Action("Index", "Product")" method="get" role="search">
                    <input type="search"
                           name="keyword"
                           value="@Request.QueryString["keyword"]"
                           placeholder="Tìm mỹ phẩm, thương hiệu..."
                           aria-label="Tìm kiếm sản phẩm"
                           autocomplete="off" />
                    <button type="submit" aria-label="Tìm kiếm">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="10.8" cy="10.8" r="6.8"></circle>
                            <path d="M16 16 21 21"></path>
                        </svg>
                    </button>
                </form>

                <div class="header-actions">
                    <!-- MENU TÀI KHOẢN: rê chuột vào để hiện các lựa chọn -->
                    <div class="header-account" id="accountMenu">
                        <a href="@accountUrl"
                           class="header-action account-trigger"
                           id="accountTrigger"
                           aria-expanded="false"
                           aria-controls="accountDropdown">
                            <span class="header-action-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="12" cy="8" r="4"></circle>
                                    <path d="M4 21v-2a8 8 0 0 1 16 0v2"></path>
                                </svg>
                            </span>
                            <span class="header-action-label account-label">
                                <span class="account-label-text">@(isLoggedIn ?  accountLabel : "Tài khoản")</span>
                                <svg class="account-caret" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M6 9l6 6 6-6"></path>
                                </svg>
                            </span>
                        </a>

                        <nav class="account-dropdown" id="accountDropdown" aria-label="Menu tài khoản">
                            <div class="account-dropdown-panel">
                                @if (isLoggedIn)
                                {
                                    <div class="account-dropdown-head">
                                        <span class="account-dropdown-name">@accountLabel</span>
                                        @if (!string.IsNullOrEmpty(accountEmail))
                                        {
                                            <span class="account-dropdown-email">@accountEmail</span>
                                        }
                                    </div>
                                    <div class="account-divider"></div>

                                    <a class="account-item" href="@Url.Action("Profile", "Account")">
                                        <svg class="account-item-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <circle cx="12" cy="8" r="4"></circle>
                                            <path d="M4 21v-2a8 8 0 0 1 16 0v2"></path>
                                        </svg>
                                        <span>Tài khoản của bạn</span>
                                    </a>
                                    <a class="account-item" href="@Url.Action("History", "Order")">
                                        <svg class="account-item-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"></path>
                                            <path d="M9 8h6M9 12h6"></path>
                                        </svg>
                                        <span>Quản lý đơn hàng</span>
                                    </a>
                                    if (isAdmin)
                                    {
                                        <a class="account-item" href="@Url.Action("Index", "AdminDashboard")">
                                            <svg class="account-item-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6z"></path>
                                            </svg>
                                            <span>Trang quản trị</span>
                                        </a>
                                    }
                                    <div class="account-divider"></div>
                                    <a class="account-item account-item--danger" href="@Url.Action("Logout", "Account")">
                                        <svg class="account-item-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                            <path d="M16 17l5-5-5-5M21 12H9"></path>
                                        </svg>
                                        <span>Đăng xuất</span>
                                    </a>
                                }
                                else
                                {
                                    <a class="account-item" href="@Url.Action("Login", "Account")">
                                        <svg class="account-item-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                                            <path d="M10 17l5-5-5-5M15 12H3"></path>
                                        </svg>
                                        <span>Đăng nhập</span>
                                    </a>
                                    <a class="account-item" href="@Url.Action("Register", "Account")">
                                        <svg class="account-item-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <circle cx="9" cy="8" r="4"></circle>
                                            <path d="M2 21v-2a7 7 0 0 1 14 0v2M19 8v6M22 11h-6"></path>
                                        </svg>
                                        <span>Đăng ký</span>
                                    </a>
                                }
                            </div>
                        </nav>
                    </div>
                    <a href="@Url.Action("Index", "Cart")"
                       class="header-action cart-action">
                        <span class="header-action-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M3 3h2l2.4 12.2a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 7H6"></path>
                                <circle cx="10" cy="21" r="1"></circle>
                                <circle cx="19" cy="21" r="1"></circle>
                            </svg>
                            <span id="headerCartCount" class="cart-badge">@Html.Action("Badge", "Cart")</span>
                        </span>
                        <span class="header-action-label">Giỏ hàng</span>
                    </a>
                </div>

                <button type="button"
                        class="menu-toggle"
                        id="menuToggle"
                        aria-label="Mở menu"
                        aria-expanded="false"
                        aria-controls="mainNav">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>

            <!-- MENU DANH MỤC ĐỘNG TỪ CƠ SỞ DỮ LIỆU -->
            @Html.Action("CategoryMenu", "Product")
        </div>
    </header>

    <main id="mainContent">
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3"><div class="alert alert-success mb-0" role="status">@TempData["Success"]</div></div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="container mt-3"><div class="alert alert-danger mb-0" role="alert">@TempData["Error"]</div></div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4 py-5">
                <div class="col-12 col-md-6 col-lg-4">
                    <a class="brand footer-brand"
                       href="@Url.Action("Index", "Home")">
                        <span class="brand-highlight">Beauty</span><span>Cosmetic</span>
                        <span class="brand-dot">.</span>
                    </a>

                    <p class="footer-description">
                        Khám phá vẻ đẹp của chính bạn với những sản phẩm
                        chăm sóc da và làm đẹp chính hãng, an toàn mỗi ngày.
                    </p>

                    <div class="footer-social">
                        <span>Beauty begins with you.</span>
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <h2 class="footer-heading">Khám phá</h2>
                    <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                    <a href="@Url.Action("Index", "Product")">Sản phẩm</a>
                    <a href="@Url.Action("Index", "Product", new { category = "cham-soc-da" })">
                        Chăm sóc da
                    </a>
                    <a href="@Url.Action("Index", "Product", new { category = "trang-diem" })">
                        Trang điểm
                    </a>
                </div>

                <div class="col-6 col-lg-3">
                    <h2 class="footer-heading">Hỗ trợ khách hàng</h2>
                    <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
                    <a href="@Url.Action("Register", "Account")">Đăng ký</a>
                    <a href="@Url.Action("Index", "Cart")">Giỏ hàng</a>
                    <a href="@Url.Action("Profile", "Account")">Hồ sơ cá nhân</a>
                </div>

                <div class="col-12 col-lg-3">
                    <h2 class="footer-heading">Liên hệ</h2>
                    <p>Email: support@beautycosmetics.vn</p>
                    <p>Thời gian hỗ trợ: 8:00 – 21:00</p>
                    <p class="footer-note">
                        Hệ thống phân phối mỹ phẩm chính hãng & uy tín hàng đầu.
                    </p>
                </div>
            </div>

            <div class="footer-bottom">
                <span>© @DateTime.Now.Year BeautyCosmetic</span>
                <span>Bản quyền thuộc về BeautyCosmetic. All rights reserved.</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Scripts/site.js")"></script>

    <script>
        (function () {
            "use strict";
            var wrap = document.getElementById("accountMenu");
            if (!wrap) { return; }
            var trigger = document.getElementById("accountTrigger");
            var touchOnly = window.matchMedia && window.matchMedia("(hover: none)").matches;

            function setOpen(open) {
                wrap.classList.toggle("is-open", open);
                trigger.setAttribute("aria-expanded", String(open));
            }

            // Điện thoại/máy tính bảng: chạm lần 1 để mở menu, chạm lần 2 mới chuyển trang
            trigger.addEventListener("click", function (e) {
                if (touchOnly && !wrap.classList.contains("is-open")) {
                    e.preventDefault();
                    setOpen(true);
                }
            });

            // Máy tính: cập nhật aria-expanded theo việc rê chuột vào/ra
            wrap.addEventListener("mouseenter", function () {
                if (!touchOnly) { trigger.setAttribute("aria-expanded", "true"); }
            });
            wrap.addEventListener("mouseleave", function () {
                if (!touchOnly && !wrap.classList.contains("is-open")) {
                    trigger.setAttribute("aria-expanded", "false");
                }
            });

            // Bấm ra ngoài hoặc nhấn Esc để đóng
            document.addEventListener("click", function (e) {
                if (!wrap.contains(e.target)) { setOpen(false); }
            });
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") {
                    setOpen(false);
                    if (wrap.contains(document.activeElement)) { document.activeElement.blur(); }
                }
            });
        })();
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
