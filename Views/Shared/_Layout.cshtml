<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - BeautyCosmetic</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="@Url.Content("~/Content/site.css")" />

    <link rel="stylesheet"
          href="@Url.Content("~/Content/home.css")" />

    @RenderSection("styles", required: false)
</head>
<body>
    <div class="top-notice">
        <div class="container text-center">
            <span>BeautyCosmetic</span>
            <span class="notice-divider">|</span>
            Chăm sóc vẻ đẹp của bạn mỗi ngày
        </div>
    </div>

    <header class="site-header">
        <div class="container">
            <div class="header-main">
                <a class="brand"
                   href="@Url.Action("Index", "Home")"
                   aria-label="BeautyCosmetic - Trang chủ">
                    <span class="brand-highlight">Beauty</span><span>Cosmetic</span>
                    <span class="brand-dot">.</span>
                </a>

                <form class="search-box"
                      action="@Url.Action("Index", "Product")"
                      method="get"
                      role="search">
                    <input type="search"
                           name="keyword"
                           placeholder="Tìm mỹ phẩm, thương hiệu..."
                           aria-label="Tìm kiếm sản phẩm" />

                    <button type="submit" aria-label="Tìm kiếm">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="10.8" cy="10.8" r="6.8"></circle>
                            <path d="m16 16 5 5"></path>
                        </svg>
                    </button>
                </form>

                <div class="header-actions">
                    <a href="@Url.Action("Login", "Account")"
                       class="header-action">
                        <span class="header-action-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="8" r="4"></circle>
                                <path d="M4 21v-2a8 8 0 0 1 16 0v2"></path>
                            </svg>
                        </span>
                        <span class="header-action-label">Tài khoản</span>
                    </a>

                    <a href="@Url.Action("Index", "Cart")"
                       class="header-action cart-action">
                        <span class="header-action-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M3 3h2l2.4 12.2a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 7H6"></path>
                                <circle cx="10" cy="21" r="1"></circle>
                                <circle cx="19" cy="21" r="1"></circle>
                            </svg>
                            <span id="headerCartCount" class="cart-badge">0</span>
                        </span>
                        <span class="header-action-label">Giỏ hàng</span>
                    </a>
                </div>

                <button type="button"
                        class="menu-toggle"
                        id="menuToggle"
                        aria-label="Mở menu"
                        aria-expanded="false"
                        aria-controls="mainNav">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>

            <nav class="category-nav" id="mainNav" aria-label="Danh mục chính">
                <a href="@Url.Action("Index", "Home")" class="nav-link-custom">
                    Trang chủ
                </a>

                <a href="@Url.Action("Index", "Product")" class="nav-link-custom">
                    Tất cả sản phẩm
                </a>

                <a href="@Url.Action("Index", "Product", new { category = "cham-soc-da" })"
                   class="nav-link-custom">
                    Chăm sóc da
                </a>

                <a href="@Url.Action("Index", "Product", new { category = "trang-diem" })"
                   class="nav-link-custom">
                    Trang điểm
                </a>

                <a href="@Url.Action("Index", "Product", new { category = "chong-nang" })"
                   class="nav-link-custom">
                    Chống nắng
                </a>

                <a href="@Url.Action("Index", "Product", new { category = "duong-am" })"
                   class="nav-link-custom">
                    Dưỡng ẩm
                </a>
            </nav>
        </div>
    </header>

    <main id="mainContent">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4 py-5">
                <div class="col-12 col-md-6 col-lg-4">
                    <a class="brand footer-brand"
                       href="@Url.Action("Index", "Home")">
                        <span class="brand-highlight">Beauty</span><span>Cosmetic</span>
                        <span class="brand-dot">.</span>
                    </a>

                    <p class="footer-description">
                        Khám phá vẻ đẹp của chính bạn với những sản phẩm
                        chăm sóc da và làm đẹp phù hợp mỗi ngày.
                    </p>

                    <div class="footer-social">
                        <span>Beauty begins with you.</span>
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <h2 class="footer-heading">Khám phá</h2>
                    <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                    <a href="@Url.Action("Index", "Product")">Sản phẩm</a>
                    <a href="@Url.Action("Index", "Product", new { category = "cham-soc-da" })">
                        Chăm sóc da
                    </a>
                    <a href="@Url.Action("Index", "Product", new { category = "trang-diem" })">
                        Trang điểm
                    </a>
                </div>

                <div class="col-6 col-lg-3">
                    <h2 class="footer-heading">Hỗ trợ khách hàng</h2>
                    <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
                    <a href="@Url.Action("Register", "Account")">Đăng ký</a>
                    <a href="@Url.Action("Index", "Cart")">Giỏ hàng</a>
                    <a href="@Url.Action("Profile", "Account")">Hồ sơ cá nhân</a>
                </div>

                <div class="col-12 col-lg-3">
                    <h2 class="footer-heading">Liên hệ</h2>
                    <p>Email: support@beautycosmetics.vn</p>
                    <p>Thời gian hỗ trợ: 8:00 – 21:00</p>
                    <p class="footer-note">
                        Thông tin liên hệ minh họa cho đồ án.
                    </p>
                </div>
            </div>

            <div class="footer-bottom">
                <span>© @DateTime.Now.Year BeautyCosmetic</span>
                <span>Giao diện học tập – Frontend Demo</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Scripts/site.js")"></script>

    @RenderSection("scripts", required: false)
</body>
</html>