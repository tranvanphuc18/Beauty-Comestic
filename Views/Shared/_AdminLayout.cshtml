<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - @ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f6f9;
        }

        #sidebar {
            width: 250px;
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #212529;
            color: #fff;
            z-index: 1000;
        }

            #sidebar .brand {
                padding: 18px 20px;
                font-size: 1.15rem;
                font-weight: bold;
                background: #1a1e21;
                border-bottom: 1px solid #2c3034;
            }

            #sidebar ul.nav {
                flex-direction: column;
                padding: 15px 0;
            }

                #sidebar ul.nav li a {
                    color: #adb5bd;
                    padding: 12px 20px;
                    display: block;
                    text-decoration: none;
                    font-size: 0.95rem;
                }

                    #sidebar ul.nav li a:hover, #sidebar ul.nav li a.active {
                        color: #fff;
                        background-color: #0d6efd;
                    }

                    #sidebar ul.nav li a i {
                        width: 25px;
                    }

        #content {
            margin-left: 250px;
            padding: 25px;
            min-height: 100vh;
        }

        .top-navbar {
            background: #fff;
            padding: 12px 25px;
            margin: -25px -25px 25px -25px;
            border-bottom: 1px solid #e3e6f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card {
            border-radius: 8px;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1);
            border: none;
        }
    </style>
</head>
<body>
    <div id="sidebar">
        <div class="brand">
            <i class="fas fa-gem text-primary mr-2"></i> Beauty Admin
        </div>
        <ul class="nav">
            <li>
                <a href="@Url.Action("Index", "AdminCategory")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "AdminCategory" ? "active" : "")">
                    <i class="fas fa-tags"></i> Quản lý danh mục
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "AdminProduct")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "AdminProduct" && ViewContext.RouteData.Values["action"].ToString() != "Inventory" ? "active" : "")">
                    <i class="fas fa-box"></i> Quản lý sản phẩm
                </a>
            </li>
            <li>
                <a href="@Url.Action("Inventory", "AdminProduct")" class="@(ViewContext.RouteData.Values["action"].ToString() == "Inventory" ? "active" : "")">
                    <i class="fas fa-warehouse"></i> Quản lý tồn kho
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "AdminOrder")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "AdminOrder" ? "active" : "")">
                    <i class="fas fa-receipt"></i> Quản lý đơn hàng
                </a>
            </li>
            <li>
                <a href="@Url.Action("Customers", "AdminUser")" class="@(ViewContext.RouteData.Values["action"].ToString() == "Customers" ? "active" : "")">
                    <i class="fas fa-users"></i> Quản lý khách hàng
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "AdminUser")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "AdminUser" && ViewContext.RouteData.Values["action"].ToString() != "Customers" ? "active" : "")">
                    <i class="fas fa-user-shield"></i> Tài khoản Admin
                </a>
            </li>
            <li class="mt-4">
                <a href="@Url.Action("Index", "Home")" target="_blank" class="text-info">
                    <i class="fas fa-globe"></i> Xem trang chủ
                </a>
            </li>
            <li>
                <a href="@Url.Action("Logout", "Account")" class="text-danger">
                    <i class="fas fa-sign-out-alt"></i> Đăng xuất
                </a>
            </li>
        </ul>
    </div>

    <div id="content">
        <div class="top-navbar">
            <h5 class="m-0 text-gray-800">@ViewBag.Title</h5>
            <div class="dropdown">
                <span class="mr-2 d-none d-lg-inline text-gray-600 small font-weight-bold">
                    <i class="fas fa-user-circle mr-1"></i> Admin: @(Session["FullName"] ?? Session["UserEmail"] ?? "Administrator")
                </span>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle mr-1"></i> @TempData["Success"]
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle mr-1"></i> @TempData["Error"]
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        }

        @RenderBody()
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>