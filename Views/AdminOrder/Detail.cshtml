@model nv3.Models.Order
@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.OrderId;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>HÓA ĐƠN BÁN HÀNG #@Model.OrderId</h4>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Quay lại danh sách</a>
    </div>
    <hr />

    <div class="row mb-4">
        <div class="col-md-6">
            <h5 class="text-muted">Thông tin khách hàng:</h5>
            <p class="mb-1"><strong>Họ tên:</strong> @(Model.User != null ? Model.User.FullName : "N/A")</p>
            <p class="mb-1"><strong>Email:</strong> @(Model.User != null ? Model.User.Email : "")</p>
            <p class="mb-1"><strong>Số điện thoại:</strong> @(Model.User != null ? Model.User.Phone : "")</p>
            <p class="mb-1"><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
        </div>
        <div class="col-md-6 text-md-right">
            <h5 class="text-muted">Thông tin thanh toán:</h5>
            <p class="mb-1"><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
            <p class="mb-1"><strong>Phương thức:</strong> @Model.PaymentMethod</p>
            <p class="mb-1"><strong>Trạng thái thanh toán:</strong> <span class="badge badge-secondary">@Model.PaymentStatus</span></p>
            <p class="mb-1"><strong>Trạng thái đơn hàng:</strong> <span class="badge badge-primary">@Model.OrderStatus</span></p>
        </div>
    </div>

    <!-- Form cập nhật trạng thái đơn hàng -->
    <div class="card bg-light p-3 mb-4">
        @using (Html.BeginForm("UpdateStatus", "AdminOrder", FormMethod.Post, new { @class = "form-inline" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderId" value="@Model.OrderId" />
            <label class="font-weight-bold mr-2">Cập nhật đơn hàng:</label>
            <select name="orderStatus" class="form-control mr-2">
                <option value="Pending" @(Model.OrderStatus == "Pending" ? "selected" : "")>Pending (Chờ duyệt)</option>
                <option value="Confirmed" @(Model.OrderStatus == "Confirmed" ? "selected" : "")>Confirmed (Đã duyệt)</option>
                <option value="Shipping" @(Model.OrderStatus == "Shipping" ? "selected" : "")>Shipping (Đang giao)</option>
                <option value="Completed" @(Model.OrderStatus == "Completed" ? "selected" : "")>Completed (Hoàn tất)</option>
                <option value="Cancelled" @(Model.OrderStatus == "Cancelled" ? "selected" : "")>Cancelled (Hủy đơn)</option>
            </select>
            <select name="paymentStatus" class="form-control mr-2">
                <option value="Unpaid" @(Model.PaymentStatus == "Unpaid" ? "selected" : "")>Unpaid</option>
                <option value="Paid" @(Model.PaymentStatus == "Paid" ? "selected" : "")>Paid</option>
                <option value="Refunded" @(Model.PaymentStatus == "Refunded" ? "selected" : "")>Refunded</option>
            </select>
            <button type="submit" class="btn btn-success"><i class="fas fa-check mr-1"></i> Lưu thay đổi</button>
        }
    </div>

    <!-- Danh sách sản phẩm dạng hóa đơn -->
    <table class="table table-bordered">
        <thead class="thead-light">
            <tr>
                <th>#</th>
                <th>Sản phẩm</th>
                <th>Phân loại</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @{ int stt = 1; }
            @foreach (var d in Model.OrderDetails)
            {
                <tr>
                    <td>@stt++</td>
                    <td><strong>@(d.ProductDetail != null && d.ProductDetail.Product != null ? d.ProductDetail.Product.Name : "N/A")</strong></td>
                    <td>@(d.ProductDetail != null ? d.ProductDetail.DetailName : "")</td>
                    <td>@string.Format("{0:N0} đ", d.UnitPrice)</td>
                    <td>@d.Quantity</td>
                    <td class="font-weight-bold">@string.Format("{0:N0} đ", d.LineTotal)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="5" class="text-right font-weight-bold">TỔNG CỘNG HÓA ĐƠN:</td>
                <td class="text-danger font-weight-bold" style="font-size: 1.2rem;">@string.Format("{0:N0} đ", Model.TotalAmount)</td>
            </tr>
        </tfoot>
    </table>
</div>