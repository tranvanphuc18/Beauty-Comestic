@model IEnumerable<nv3.Models.Order>
@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="card p-3">
    <h4 class="mb-3 text-primary">Danh sách đơn hàng (@ViewBag.TotalCount đơn)</h4>

    <!-- Bộ lọc tìm kiếm theo Checklist -->
    @using (Html.BeginForm("Index", "AdminOrder", FormMethod.Get, new { @class = "bg-light p-3 rounded mb-3" }))
    {
        <div class="form-row">
            <div class="col-md-3 mb-2">
                <input type="text" name="searchCustomer" value="@ViewBag.SearchCustomer" class="form-control" placeholder="Tìm tên hoặc email..." />
            </div>
            <div class="col-md-2 mb-2">
                <select name="orderStatus" class="form-control">
                    <option value="">-- Trạng thái đơn --</option>
                    <option value="Pending" @(ViewBag.OrderStatus == "Pending" ? "selected" : "")>Pending (Chờ duyệt)</option>
                    <option value="Confirmed" @(ViewBag.OrderStatus == "Confirmed" ? "selected" : "")>Confirmed (Đã duyệt)</option>
                    <option value="Shipping" @(ViewBag.OrderStatus == "Shipping" ? "selected" : "")>Shipping (Đang giao)</option>
                    <option value="Completed" @(ViewBag.OrderStatus == "Completed" ? "selected" : "")>Completed (Hoàn thành)</option>
                    <option value="Cancelled" @(ViewBag.OrderStatus == "Cancelled" ? "selected" : "")>Cancelled (Đã hủy)</option>
                </select>
            </div>
            <div class="col-md-2 mb-2">
                <select name="paymentStatus" class="form-control">
                    <option value="">-- Thanh toán --</option>
                    <option value="Unpaid" @(ViewBag.PaymentStatus == "Unpaid" ? "selected" : "")>Unpaid (Chưa trả)</option>
                    <option value="Paid" @(ViewBag.PaymentStatus == "Paid" ? "selected" : "")>Paid (Đã trả)</option>
                    <option value="Refunded" @(ViewBag.PaymentStatus == "Refunded" ? "selected" : "")>Refunded (Hoàn tiền)</option>
                </select>
            </div>
            <div class="col-md-2 mb-2">
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" title="Từ ngày" />
            </div>
            <div class="col-md-2 mb-2">
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" title="Đến ngày" />
            </div>
            <div class="col-md-1 mb-2">
                <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-search"></i> Lọc</button>
            </div>
        </div>
    }

    <table class="table table-bordered table-hover">
        <thead class="thead-light">
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Đơn hàng</th>
                <th>Thanh toán</th>
                <th style="width: 100px;">Chi tiết</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>#@item.OrderId</strong></td>
                    <td>@(item.User != null ? item.User.FullName : "Khách vãng lai")</td>
                    <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-danger font-weight-bold">@string.Format("{0:N0} đ", item.TotalAmount)</td>
                    <td>
                        <span class="badge badge-info">@item.OrderStatus</span>
                    </td>
                    <td>
                        <span class="badge badge-secondary">@item.PaymentStatus</span>
                    </td>
                    <td>
                        <a href="@Url.Action("Detail", new { id = item.OrderId })" class="btn btn-sm btn-info btn-block">
                            <i class="fas fa-file-invoice"></i> Xem
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Phân trang 15 đơn/trang -->
    @if (totalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, searchCustomer = ViewBag.SearchCustomer, orderStatus = ViewBag.OrderStatus, paymentStatus = ViewBag.PaymentStatus, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>