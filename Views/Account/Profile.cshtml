@model nv3.ViewModels.ProfileViewModel
@{
    ViewBag.Title = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="account-section profile-section">
    <div class="container">
        <div class="profile-card">

            <div class="profile-heading">
                <div class="profile-avatar">BC</div>

                <div>
                    <h1>Hồ sơ cá nhân</h1>
                    <p class="account-subtitle">
                        Quản lý thông tin tài khoản BeautyCosmetic
                    </p>
                </div>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>
            }

            @using (Html.BeginForm("Profile", "Account", FormMethod.Post, new { id = "profileForm" }))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="profileName" class="form-label">Họ và tên</label>
                    <input type="text" class="form-control" id="profileName" name="FullName"
                           value="@Model.FullName" maxlength="100" required />
                </div>

                <div class="mb-3">
                    <label for="profileEmail" class="form-label">Email</label>
                    <input type="email" class="form-control" id="profileEmail"
                           value="@Model.Email" readonly />
                </div>

                <div class="mb-3">
                    <label for="profilePhone" class="form-label">Số điện thoại</label>
                    <input type="tel" class="form-control" id="profilePhone" name="Phone"
                           value="@Model.Phone" pattern="0[0-9]{9}" />
                    <small class="text-muted">Số điện thoại gồm 10 chữ số, bắt đầu bằng số 0.</small>
                </div>

                <div class="mb-4">
                    <label for="profileAddress" class="form-label">Địa chỉ</label>
                    <input type="text" class="form-control" id="profileAddress" name="Address"
                           value="@Model.Address" maxlength="300" />
                </div>

                <button type="submit" class="btn btn-pink w-100">Lưu thông tin</button>
            }

            <div class="profile-links">
                <a href="@Url.Action("History", "Order")">Lịch sử giao dịch</a>
                <span>|</span>
                <a href="@Url.Action("Index", "Cart")">Xem giỏ hàng</a>
                <span>|</span>
                <a href="@Url.Action("Logout", "Account")">Đăng xuất</a>
            </div>

        </div>
    </div>
</section>
