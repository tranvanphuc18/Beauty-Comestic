@model nv3.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/account.css")" />
}

<section class="account-section">
    <div class="account-card account-card-register">
        <a class="account-brand" href="@Url.Action("Index", "Home")">
            <span class="account-brand-icon">B</span>
            <span>Beauty<span class="brand-highlight">Cosmetic</span></span>
        </a>

        <div class="account-heading">
            <h1>Tạo tài khoản mới</h1>
            <p>Tham gia BeautyCosmetic để khám phá những sản phẩm làm đẹp yêu thích.</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="account-message" role="alert">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <form id="registerForm" method="post" action="@Url.Action("Register", "Account")">
            @Html.AntiForgeryToken()
            <div class="account-field">
                <label for="registerName">Họ và tên</label>
                <input type="text"
                       id="registerName"
                       name="FullName"
                       value="@Model.FullName"
                       class="form-control"
                       placeholder="Nhập họ và tên"
                       autocomplete="name"
                       maxlength="100"
                       required />
            </div>

            <div class="account-field">
                <label for="registerEmail">Email</label>
                <input type="email"
                       id="registerEmail"
                       name="Email"
                       value="@Model.Email"
                       class="form-control"
                       placeholder="Nhập địa chỉ email"
                       autocomplete="email"
                       required />
            </div>

            <div class="account-field">
                <label for="registerPassword">Mật khẩu</label>

                <div class="password-field">
                    <input type="password"
                           id="registerPassword"
                           name="Password"
                           class="form-control"
                           placeholder="Tối thiểu 8 ký tự"
                           autocomplete="new-password"
                           minlength="8"
                           required />

                    <button type="button"
                            class="password-toggle"
                            data-password-target="registerPassword"
                            aria-label="Hiện mật khẩu"
                            aria-pressed="false">
                        <svg class="icon-eye"
                             viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>

                        <svg class="icon-eye-off"
                             viewBox="0 0 24 24"
                             aria-hidden="true"
                             hidden>
                            <path d="m3 3 18 18"></path>
                            <path d="M10.6 5.1A10.9 10.9 0 0 1 12 5c6.4 0 10 7 10 7a16 16 0 0 1-3.1 3.9"></path>
                            <path d="M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7c1.3 0 2.5-.3 3.6-.8"></path>
                            <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"></path>
                        </svg>
                    </button>
                </div>

                <div class="password-strength" aria-live="polite">
                    <div class="password-strength-track">
                        <span id="passwordStrengthBar"></span>
                    </div>
                    <small id="passwordStrengthText">Độ mạnh mật khẩu</small>
                </div>
            </div>

            <div class="account-field">
                <label for="confirmPassword">Xác nhận mật khẩu</label>

                <div class="password-field">
                    <input type="password"
                           id="confirmPassword"
                           name="ConfirmPassword"
                           class="form-control"
                           placeholder="Nhập lại mật khẩu"
                           autocomplete="new-password"
                           required />

                    <button type="button"
                            class="password-toggle"
                            data-password-target="confirmPassword"
                            aria-label="Hiện mật khẩu"
                            aria-pressed="false">
                        <svg class="icon-eye"
                             viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>

                        <svg class="icon-eye-off"
                             viewBox="0 0 24 24"
                             aria-hidden="true"
                             hidden>
                            <path d="m3 3 18 18"></path>
                            <path d="M10.6 5.1A10.9 10.9 0 0 1 12 5c6.4 0 10 7 10 7a16 16 0 0 1-3.1 3.9"></path>
                            <path d="M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7c1.3 0 2.5-.3 3.6-.8"></path>
                            <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"></path>
                        </svg>
                    </button>
                </div>
                <small id="confirmPasswordError" class="field-error"></small>
            </div>

            <label class="account-checkbox account-terms">
                <input type="checkbox" id="acceptTerms" required />
                <span>Tôi đồng ý với các điều khoản sử dụng của website.</span>
            </label>

            <button type="submit" class="account-submit">
                Tạo tài khoản
            </button>
        </form>

        <p class="account-switch">
            Đã có tài khoản?
            <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
        </p>

        <a class="account-back" href="@Url.Action("Index", "Home")">
            ← Quay lại trang chủ
        </a>
    </div>
</section>

@section scripts {
    <script src="@Url.Content("~/Scripts/account.js")"></script>
}