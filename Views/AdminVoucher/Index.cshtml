@model IEnumerable<nv3.Models.Voucher>
@{
    ViewBag.Title = "Quản lý mã Voucher / Khuyến mãi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    DateTime now = DateTime.Now;
}

<div class="card p-3 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="m-0 text-primary"><i class="fas fa-ticket-alt mr-2"></i>Quản lý Voucher (@ViewBag.TotalCount mã)</h4>
        <a href="@Url.Action("Create")" class="btn btn-primary font-weight-bold">
            <i class="fas fa-plus mr-1"></i> Tạo Voucher mới
        </a>
    </div>

    <!-- Bộ lọc & tìm kiếm -->
    @using (Html.BeginForm("Index", "AdminVoucher", FormMethod.Get, new { @class = "bg-light p-3 rounded mb-3" }))
    {
        <div class="form-row align-items-center">
            <div class="col-md-5 mb-2">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo mã hoặc tên voucher..." />
            </div>
            <div class="col-md-4 mb-2">
                <select name="status" class="form-control">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="active" @(ViewBag.Status == "active" ? "selected" : "")>Đang hoạt động (Hiệu lực)</option>
                    <option value="inactive" @(ViewBag.Status == "inactive" ? "selected" : "")>Đã tạm khóa</option>
                    <option value="expired" @(ViewBag.Status == "expired" ? "selected" : "")>Đã hết hạn</option>
                    <option value="out_of_stock" @(ViewBag.Status == "out_of_stock" ? "selected" : "")>Đã hết lượt dùng</option>
                </select>
            </div>
            <div class="col-md-3 mb-2 d-flex">
                <button type="submit" class="btn btn-primary mr-2 flex-grow-1"><i class="fas fa-search mr-1"></i> Lọc</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Đặt lại</a>
            </div>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="thead-light">
                <tr>
                    <th style="width: 50px;" class="text-center">#</th>
                    <th>Mã Voucher</th>
                    <th>Chương trình / Tiêu đề</th>
                    <th>Mức giảm</th>
                    <th>Đơn tối thiểu</th>
                    <th class="text-center">Số lượng</th>
                    <th>Thời hạn áp dụng</th>
                    <th class="text-center">Trạng thái</th>
                    <th style="width: 140px;" class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">Chưa có mã khuyến mãi nào phù hợp.</td>
                    </tr>
                }
                else
                {
                    int stt = 1;
                    foreach (var item in Model)
                    {
                        bool isExpired = item.EndDate < now;
                        bool isOutOfStock = item.Quantity <= 0;
                        bool isNotStarted = item.StartDate > now;

                        <tr>
                            <td class="text-center font-weight-bold">@(stt++)</td>
                            <td>
                                <span class="badge badge-light border border-danger text-danger px-2 py-1 font-weight-bold" style="font-size: 13px; letter-spacing: 0.5px;">
                                    <i class="fas fa-tag mr-1"></i>@item.Code
                                </span>
                            </td>
                            <td>
                                <strong class="text-dark">@item.Title</strong>
                            </td>
                            <td>
                                @if (item.DiscountType == "Percent")
                                {
                                    <span class="text-success font-weight-bold">Giảm @item.DiscountValue.ToString("0.##")%</span>
                                    if (item.MaxDiscountAmount.HasValue && item.MaxDiscountAmount.Value > 0)
                                    {
                                        <small class="d-block text-muted">Tối đa: @item.MaxDiscountAmount.Value.ToString("N0") đ</small>
                                    }
                                }
                                else
                                {
                                    <span class="text-danger font-weight-bold">Giảm @item.DiscountValue.ToString("N0") đ</span>
                                }
                            </td>
                            <td>
                                @if (item.MinOrderAmount > 0)
                                {
                                    <span>Từ @item.MinOrderAmount.ToString("N0") đ</span>
                                }
                                else
                                {
                                    <span class="text-muted">Không giới hạn</span>
                                }
                            </td>
                            <td class="text-center font-weight-bold @(isOutOfStock ? "text-danger" : "text-dark")">
                                @item.Quantity
                            </td>
                            <td class="small">
                                <div><i class="fas fa-calendar-alt text-muted mr-1"></i>Từ: @item.StartDate.ToString("dd/MM/yyyy")</div>
                                <div><i class="fas fa-clock text-muted mr-1"></i>Đến: @item.EndDate.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td class="text-center">
                                @if (!item.IsActive)
                                {
                                    <span class="badge badge-secondary px-2 py-1">Tạm khóa</span>
                                }
                                else if (isExpired)
                                {
                                    <span class="badge badge-warning text-dark px-2 py-1">Hết hạn</span>
                                }
                                else if (isOutOfStock)
                                {
                                    <span class="badge badge-danger px-2 py-1">Hết lượt</span>
                                }
                                else if (isNotStarted)
                                {
                                    <span class="badge badge-info px-2 py-1">Sắp diễn ra</span>
                                }
                                else
                                {
                                    <span class="badge badge-success px-2 py-1">Đang hoạt động</span>
                                }
                            </td>
                            <td class="text-center text-nowrap">
                                <!-- Bật/Tắt nhanh -->
                                @using (Html.BeginForm("ToggleStatus", "AdminVoucher", new { id = item.VoucherId }, FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-secondary" : "btn-outline-success") mr-1"
                                            title="@(item.IsActive ? "Tạm khóa mã này" : "Kích hoạt mã này")">
                                        <i class="fas @(item.IsActive ? "fa-pause" : "fa-play")"></i>
                                    </button>
                                }

                                <!-- Sửa -->
                                <a href="@Url.Action("Edit", new { id = item.VoucherId })" class="btn btn-sm btn-warning mr-1" title="Chỉnh sửa">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <!-- Xóa -->
                                @using (Html.BeginForm("Delete", "AdminVoucher", new { id = item.VoucherId }, FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa mã @item.Code?');" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
