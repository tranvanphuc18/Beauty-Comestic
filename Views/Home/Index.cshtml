@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="home-hero">
    <div class="container">
        <div class="hero-panel">
            <div class="hero-content">
                <span class="hero-eyebrow">
                    BEAUTY STARTS WITH YOU
                </span>

                <h1>
                    Dịu dàng chăm sóc.
                    <span>Rạng rỡ theo cách riêng.</span>
                </h1>

                <p>
                    Khám phá những sản phẩm chăm sóc da và làm đẹp
                    giúp bạn yêu chiều bản thân mỗi ngày.
                </p>

                <div class="hero-actions">
                    <a href="@Url.Action("Index", "Product")"
                       class="btn-pink">
                        Khám phá sản phẩm
                        <span aria-hidden="true">→</span>
                    </a>

                    <a href="#home-categories" class="hero-secondary-link">
                        Khám phá danh mục
                    </a>
                </div>

                <div class="hero-trust">
                    <span class="trust-check">✓</span>
                    Gợi ý làm đẹp dành cho bạn
                </div>
            </div>

            <div class="hero-visual">
                <div class="hero-image-frame">
                    <img src="https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?auto=format&fit=crop&w=1000&q=85"
                         alt="Sản phẩm chăm sóc da và làm đẹp"
                         fetchpriority="high" />
                </div>

                <div class="hero-floating-note">
                    <span class="floating-heart">♡</span>
                    <div>
                        <strong>Love your skin</strong>
                        <small>Yêu chiều làn da mỗi ngày</small>
                    </div>
                </div>

                <div class="hero-decoration hero-decoration-one"></div>
                <div class="hero-decoration hero-decoration-two"></div>
            </div>
        </div>
    </div>
</section>

<section class="home-benefits">
    <div class="container">
        <div class="row g-3">
            <div class="col-6 col-lg-3">
                <div class="benefit-item">
                    <span class="benefit-icon">♡</span>
                    <div>
                        <strong>Chăm sóc tận tâm</strong>
                        <small>Quan tâm đến nhu cầu của bạn</small>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="benefit-item">
                    <span class="benefit-icon">✧</span>
                    <div>
                        <strong>Đa dạng lựa chọn</strong>
                        <small>Nhiều dòng mỹ phẩm</small>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="benefit-item">
                    <span class="benefit-icon">♡</span>
                    <div>
                        <strong>Ưu tiên trải nghiệm</strong>
                        <small>Mua sắm dễ dàng, thuận tiện</small>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="benefit-item">
                    <span class="benefit-icon">✿</span>
                    <div>
                        <strong>Vẻ đẹp riêng bạn</strong>
                        <small>Tự tin theo cách của mình</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="home-section" id="home-categories">
    <div class="container">
        <div class="section-topline">
            <div>
                <span class="section-eyebrow">FIND YOUR BEAUTY</span>
                <h2 class="section-heading">Khám phá danh mục</h2>
                <p class="section-subtitle">
                    Bắt đầu hành trình chăm sóc bản thân từ những điều phù hợp nhất.
                </p>
            </div>

            <a href="@Url.Action("Index", "Product")"
               class="section-more">
                Xem tất cả <span aria-hidden="true">→</span>
            </a>
        </div>

        <div class="row g-3 g-md-4">
            <div class="col-6 col-lg-3">
                <a class="category-card"
                   href="@Url.Action("Index", "Product", new { category = "cham-soc-da" })">
                    <div class="category-image category-image-skincare">
                        <img src="https://images.unsplash.com/photo-1556229010-6c3f2c9ca5f8?auto=format&fit=crop&w=650&q=80"
                             alt="Danh mục chăm sóc da"
                             loading="lazy" />
                        <span class="category-arrow" aria-hidden="true">↗</span>
                    </div>
                    <div class="category-info">
                        <h3>Chăm sóc da</h3>
                        <p>Làm sạch và nuôi dưỡng</p>
                    </div>
                </a>
            </div>

            <div class="col-6 col-lg-3">
                <a class="category-card"
                   href="@Url.Action("Index", "Product", new { category = "trang-diem" })">
                    <div class="category-image category-image-makeup">
                        <img src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=650&q=80"
                             alt="Danh mục trang điểm"
                             loading="lazy" />
                        <span class="category-arrow" aria-hidden="true">↗</span>
                    </div>
                    <div class="category-info">
                        <h3>Trang điểm</h3>
                        <p>Tôn lên nét đẹp riêng</p>
                    </div>
                </a>
            </div>

            <div class="col-6 col-lg-3">
                <a class="category-card"
                   href="@Url.Action("Index", "Product", new { category = "chong-nang" })">
                    <div class="category-image category-image-sunscreen">
                        <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=650&q=80"
                             alt="Danh mục chống nắng"
                             loading="lazy" />
                        <span class="category-arrow" aria-hidden="true">↗</span>
                    </div>
                    <div class="category-info">
                        <h3>Chống nắng</h3>
                        <p>Bảo vệ da mỗi ngày</p>
                    </div>
                </a>
            </div>

            <div class="col-6 col-lg-3">
                <a class="category-card"
                   href="@Url.Action("Index", "Product", new { category = "duong-am" })">
                    <div class="category-image category-image-moisturizer">
                        <img src="https://images.unsplash.com/photo-1601049541289-9b1b7bbbfe19?auto=format&fit=crop&w=650&q=80"
                             alt="Danh mục dưỡng ẩm"
                             loading="lazy" />
                        <span class="category-arrow" aria-hidden="true">↗</span>
                    </div>
                    <div class="category-info">
                        <h3>Dưỡng ẩm</h3>
                        <p>Cho làn da mềm mịn</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="home-section featured-section" id="featured-products">
    <div class="container">
        <div class="section-topline">
            <div>
                <span class="section-eyebrow">YOUR BEAUTY PICKS</span>
                <h2 class="section-heading">Gợi ý dành cho bạn</h2>
                <p class="section-subtitle">
                    Một vài lựa chọn nổi bật để bạn bắt đầu khám phá.
                </p>
            </div>

            <a href="@Url.Action("Index", "Product")"
               class="section-more">
                Tất cả sản phẩm <span aria-hidden="true">→</span>
            </a>
        </div>

        <div class="row g-3 g-md-4">
            <div class="col-6 col-lg-3">
                <article class="home-product-card">
                    <a class="home-product-image"
                       href="@Url.Action("Index", "Product")"
                       aria-label="Khám phá sản phẩm chăm sóc da">
                        <span class="product-label">Gợi ý</span>
                        <img src="https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?auto=format&fit=crop&w=650&q=80"
                             alt="Bộ sản phẩm chăm sóc da"
                             loading="lazy" />
                    </a>
                    <div class="home-product-info">
                        <span class="product-brand">SKINCARE</span>
                        <h3>
                            <a href="@Url.Action("Index", "Product")">
                                Bộ chăm sóc da hằng ngày
                            </a>
                        </h3>
                        <p class="product-description">
                            Gợi ý cho chu trình dưỡng da
                        </p>
                        <a class="product-view-link"
                           href="@Url.Action("Index", "Product")">
                            Xem sản phẩm <span aria-hidden="true">→</span>
                        </a>
                    </div>
                </article>
            </div>

            <div class="col-6 col-lg-3">
                <article class="home-product-card">
                    <a class="home-product-image"
                       href="@Url.Action("Index", "Product")"
                       aria-label="Khám phá sản phẩm dưỡng ẩm">
                        <span class="product-label">Dưỡng da</span>
                        <img src="https://images.unsplash.com/photo-1601049541289-9b1b7bbbfe19?auto=format&fit=crop&w=650&q=80"
                             alt="Sản phẩm dưỡng ẩm"
                             loading="lazy" />
                    </a>
                    <div class="home-product-info">
                        <span class="product-brand">MOISTURIZER</span>
                        <h3>
                            <a href="@Url.Action("Index", "Product")">
                                Chăm sóc và dưỡng ẩm
                            </a>
                        </h3>
                        <p class="product-description">
                            Bổ sung độ ẩm cho làn da
                        </p>
                        <a class="product-view-link"
                           href="@Url.Action("Index", "Product")">
                            Xem sản phẩm <span aria-hidden="true">→</span>
                        </a>
                    </div>
                </article>
            </div>

            <div class="col-6 col-lg-3">
                <article class="home-product-card">
                    <a class="home-product-image"
                       href="@Url.Action("Index", "Product")"
                       aria-label="Khám phá sản phẩm trang điểm">
                        <span class="product-label">Làm đẹp</span>
                        <img src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=650&q=80"
                             alt="Sản phẩm trang điểm"
                             loading="lazy" />
                    </a>
                    <div class="home-product-info">
                        <span class="product-brand">MAKEUP</span>
                        <h3>
                            <a href="@Url.Action("Index", "Product")">
                                Bộ sưu tập trang điểm
                            </a>
                        </h3>
                        <p class="product-description">
                            Hoàn thiện phong cách của bạn
                        </p>
                        <a class="product-view-link"
                           href="@Url.Action("Index", "Product")">
                            Xem sản phẩm <span aria-hidden="true">→</span>
                        </a>
                    </div>
                </article>
            </div>

            <div class="col-6 col-lg-3">
                <article class="home-product-card">
                    <a class="home-product-image"
                       href="@Url.Action("Index", "Product")"
                       aria-label="Khám phá sản phẩm chống nắng">
                        <span class="product-label">Mỗi ngày</span>
                        <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=650&q=80"
                             alt="Sản phẩm chăm sóc da và chống nắng"
                             loading="lazy" />
                    </a>
                    <div class="home-product-info">
                        <span class="product-brand">SUN CARE</span>
                        <h3>
                            <a href="@Url.Action("Index", "Product")">
                                Chăm sóc da dưới nắng
                            </a>
                        </h3>
                        <p class="product-description">
                            Bước chăm sóc không nên bỏ qua
                        </p>
                        <a class="product-view-link"
                           href="@Url.Action("Index", "Product")">
                            Xem sản phẩm <span aria-hidden="true">→</span>
                        </a>
                    </div>
                </article>
            </div>
        </div>

        <div class="featured-note">
            <span aria-hidden="true">♡</span>
            Đây là các gợi ý minh họa. Danh sách và thông tin sản phẩm chính thức
            sẽ được hiển thị tại trang sản phẩm của nhóm.
        </div>
    </div>
</section>

<section class="home-about">
    <div class="container">
        <div class="about-panel">
            <div class="about-decoration" aria-hidden="true">♡</div>

            <div class="about-content">
                <span class="section-eyebrow">A LITTLE SELF-CARE</span>
                <h2>
                    Dành một chút yêu thương
                    <span>cho chính mình.</span>
                </h2>
                <p>
                    Làm đẹp không phải để trở thành một ai khác.
                    Đó là cách bạn chăm sóc bản thân và tự tin hơn mỗi ngày.
                </p>
                <a href="@Url.Action("Index", "Product")"
                   class="btn-pink">
                    Tìm sản phẩm phù hợp <span aria-hidden="true">→</span>
                </a>
            </div>

            <div class="about-image">
                <img src="https://images.unsplash.com/photo-1611930022073-b7a4ba5fcccd?auto=format&fit=crop&w=900&q=80"
                     alt="Không gian chăm sóc sắc đẹp"
                     loading="lazy" />
            </div>
        </div>
    </div>
</section>