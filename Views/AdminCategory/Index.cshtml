@model IEnumerable<nv3.Models.Category>
@{
    ViewBag.Title = "Quản lý danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="m-0 text-primary">Danh sách danh mục</h4>
        <a href="@Url.Action("Create")" class="btn btn-success">
            <i class="fas fa-plus"></i> Thêm danh mục
        </a>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="thead-light">
            <tr>
                <th style="width: 60px;">#</th>
                <th>Tên danh mục</th>
                <th>Mô tả</th>
                <th>Số sản phẩm</th>
                <th style="width: 150px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @{ int stt = 1; }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@stt++</td>
                    <td><strong>@item.CategoryName</strong></td>
                    <td>@item.Description</td>
                    <td><span class="badge badge-info">@(item.Products != null ? item.Products.Count : 0) sản phẩm</span></td>
                    <td>
                        <a href="@Url.Action("Edit", new { id = item.CategoryId })" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i>
                        </a>
                        @using (Html.BeginForm("Delete", "AdminCategory", new { id = item.CategoryId }, FormMethod.Post, new { style = "display:inline;" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa danh mục này?');">
                                <i class="fas fa-trash"></i>
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>