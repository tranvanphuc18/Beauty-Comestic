@model nv3.Models.Category
@{
    ViewBag.Title = "Chỉnh sửa danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card p-4 col-md-8 mx-auto">
    <h4 class="mb-3">Chỉnh sửa danh mục #@Model.CategoryId</h4>
    <hr />

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.CategoryId)

        <div class="form-group">
            <label class="font-weight-bold">Tên danh mục <span class="text-danger">*</span></label>
            @Html.TextBoxFor(m => m.CategoryName, new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(m => m.CategoryName, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="font-weight-bold">Mô tả</label>
            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3 })
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Cập nhật</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary ml-2">Hủy bỏ</a>
        </div>
    }
</div>